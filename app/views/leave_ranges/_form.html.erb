<div style="max-width: 640px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem;">
    <h2 style="margin-bottom: 0.25rem;"><%= @leave_range.persisted? ? "Edit Leave Range" : "Book Leave Range" %></h2>
    <p style="color: var(--pico-muted-color); margin-bottom: 0;">
      Apply this continuous date range to one or more people.
    </p>
  </div>

  <article>
    <%= form_with(model: @leave_range, url: (@leave_range.persisted? ? leave_range_path(@leave_range.id) : person_leave_ranges_path(@person)), method: (@leave_range.persisted? ? :patch : :post), data: { controller: "date-range" }) do |f| %>
      <fieldset style="margin-bottom: 1.25rem;">
        <legend>People</legend>
        <%= hidden_field_tag "leave_range[person_ids][]", "" %>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem;">
          <% @people.each do |person| %>
            <label style="display: inline-flex; align-items: center; gap: 0.4rem; margin: 0;">
              <%= check_box_tag "leave_range[person_ids][]", person.id, Array(@leave_range.person_ids).map(&:to_s).include?(person.id.to_s), id: "leave_range_person_id_#{person.id}" %>
              <span class="person-color-dot" style="background-color: <%= person.color %>;"></span>
              <%= person.name %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div style="margin-bottom: 1.25rem;">
        <%= f.label :title, "Holiday / Title (Optional)" %>
        <%= f.text_field :title, placeholder: "e.g. Summer Vacation, Trip to Spain (defaults to dates if blank)" %>
      </div>

      <div class="grid" style="margin-bottom: 1.25rem;">
        <div>
          <%= f.label :start_date, "Start Date" %>
          <%= f.date_field :start_date, value: @leave_range.start_date&.to_s, required: true, data: { date_range_target: "startDate", action: "change->date-range#startDateChanged input->date-range#startDateChanged" } %>
        </div>
        <div>
          <%= f.label :end_date, "End Date" %>
          <%= f.date_field :end_date, value: @leave_range.end_date&.to_s, min: @leave_range.start_date&.to_s, required: true, data: { date_range_target: "endDate" } %>
        </div>
      </div>

      <div class="grid" style="margin-bottom: 1.25rem;">
        <div>
          <%= f.label :half_day, "Leave Duration / Half Day" %>
          <%= f.select :half_day, [["Full Day", "none"], ["Morning Only (0.5 day)", "morning"], ["Afternoon Only (0.5 day)", "afternoon"]], selected: @leave_range.half_day || "none" %>
        </div>
        <div>
          <%= f.label :custom_hours, "Custom Hours / Day (Optional)" %>
          <%= f.number_field :custom_hours, step: 0.25, min: 0, max: 24, placeholder: "e.g. 3.75" %>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <%= f.label :notes, "Notes / Trip Name (Optional)" %>
        <%= f.text_field :notes, placeholder: "e.g. Summer holiday in Cornwall" %>
      </div>

      <footer style="display: flex; justify-content: flex-end; gap: 1rem;">
        <%= link_to "Cancel", (@person ? person_leave_ranges_path(@person) : leave_ranges_path), role: "button", class: "secondary outline" %>
        <%= f.submit (@leave_range.persisted? ? "Update Leave Range" : "Save Leave Range"), class: "contrast" %>
      </footer>
    <% end %>
  </article>
</div>
