<div style="max-width: 500px; margin: 0 auto;">
  <h2 style="margin-bottom: 0.5rem;">Your Details</h2>
  <p style="color: var(--pico-muted-color); margin-bottom: 1.5rem;">Update your own email address and password. Leave the password fields blank to keep your current password.</p>

  <%= form_with(model: @user, url: profile_path, method: :patch, local: true) do |f| %>
    <% if @user.errors.any? %>
      <article style="background-color: var(--pico-del-color, #fee2e2); border-color: #ef4444; color: #991b1b; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem;">
        <h4 style="color: #991b1b; margin-bottom: 0.5rem;"><%= pluralize(@user.errors.count, "error") %> prohibited this from being saved:</h4>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </article>
    <% end %>

    <div>
      <%= f.label :email_address, "Email address" %>
      <%= f.email_field :email_address, required: true %>
    </div>

    <div style="margin-top: 1rem;">
      <%= f.label :password, "New password" %>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "Leave blank to keep current password", maxlength: 72 %>
    </div>

    <div style="margin-top: 1rem;">
      <%= f.label :password_confirmation, "Confirm new password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
    </div>

    <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
      <%= f.submit "Save Changes", class: "contrast" %>
      <%= link_to "Cancel", edit_account_path, role: "button", class: "secondary outline" %>
    </div>
  <% end %>
</div>
