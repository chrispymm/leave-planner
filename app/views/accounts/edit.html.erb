<div style="max-width: 650px; margin: 0 auto;">
  <h2 style="margin-bottom: 0.5rem;">Account Settings</h2>
  <p style="color: var(--pico-muted-color); margin-bottom: 1.5rem;">These settings apply to everyone with access to <strong><%= @account.name %></strong>.</p>

  <%= form_with(model: @account, url: account_path, method: :patch, local: true) do |f| %>
    <% if @account.errors.any? %>
      <article style="background-color: var(--pico-del-color, #fee2e2); border-color: #ef4444; color: #991b1b; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem;">
        <h4 style="color: #991b1b; margin-bottom: 0.5rem;"><%= pluralize(@account.errors.count, "error") %> prohibited this from being saved:</h4>
        <ul>
          <% @account.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </article>
    <% end %>

    <div>
      <%= f.label :name, "Account Name" %>
      <%= f.text_field :name, required: true %>
    </div>

    <div style="margin-top: 1rem;">
      <%= f.label :bank_holiday_division, "UK Bank Holiday Region" %>
      <%= f.select :bank_holiday_division,
            options_for_select(
              [ [ "England & Wales", "england-and-wales" ], [ "Scotland", "scotland" ], [ "Northern Ireland", "northern-ireland" ] ],
              @account.bank_holiday_division
            ) %>
      <small>Controls which bank holidays are shown and counted on the calendar.</small>
    </div>

    <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
      <%= f.submit "Save Settings", class: "contrast" %>
      <%= link_to "Cancel", root_path, role: "button", class: "secondary outline" %>
    </div>
  <% end %>

  <hr style="margin: 2rem 0;">

  <% if flash[:invite_link] %>
    <article style="background-color: #ecfdf5; border-color: #10b981; color: #065f46; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem;">
      <strong>Share this invite link (valid for 48 hours):</strong>
      <p style="word-break: break-all; margin: 0.5rem 0 0;"><%= link_to flash[:invite_link], flash[:invite_link] %></p>
    </article>
  <% end %>

  <h3 style="margin-bottom: 0.5rem;">Members</h3>
  <p style="color: var(--pico-muted-color); margin-bottom: 1rem;">Everyone listed here can view and manage all people, leave, and school holidays on this account.</p>

  <table role="grid">
    <tbody>
      <% @memberships.each do |membership| %>
        <tr>
          <td>
            <%= membership.user.email_address %>
            <% if membership.user == Current.user %> <small>(you)</small><% end %>
            <% if membership.user == @account.owner %> <small>&middot; Owner</small><% end %>
          </td>
          <td style="text-align: right; white-space: nowrap;">
            <% if membership.user == Current.user %>
              <%= link_to "Edit", edit_profile_path, role: "button", class: "outline secondary" %>
            <% end %>
            <% if Current.user == @account.owner && membership.user != @account.owner %>
              <%= button_to "Remove", account_membership_path(membership), method: :delete, class: "outline contrast", data: { turbo_confirm: "Remove #{membership.user.email_address} from this account?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @invitations.any? %>
    <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem;">Pending Invitations</h4>
    <table role="grid">
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr>
            <td>
              <%= invitation.email %>
              <small>&middot; expires <%= invitation.expires_at.strftime("%d %b %Y %H:%M") %></small>
            </td>
            <td style="text-align: right;">
              <%= button_to "Cancel", account_invitation_path(invitation), method: :delete, class: "outline contrast", data: { turbo_confirm: "Cancel this invitation?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%= link_to "Invite a member", new_account_invitation_path, role: "button", class: "secondary outline", style: "margin-top: 1rem;" %>
</div>
