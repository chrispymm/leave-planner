<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="margin-bottom: 0.25rem;">School Holidays</h2>
    <p style="color: var(--pico-muted-color); margin-bottom: 0;">School terms and holiday dates marked on your leave calendar.</p>
  </div>
  <div>
    <%= link_to "+ Add School Holiday", new_school_holiday_path, role: "button" %>
  </div>
</div>

<% if @school_holidays.empty? %>
  <article style="text-align: center; padding: 3rem 1rem;">
    <h3>No school holidays added yet</h3>
    <p>Add term breaks and half terms to visualize them against your leave calendar.</p>
    <%= link_to "Add School Holiday", new_school_holiday_path, role: "button" %>
  </article>
<% else %>
  <div style="overflow-x: auto;">
    <table role="grid">
      <thead>
        <tr>
          <th>Holiday</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Duration</th>
          <th>Notes</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @school_holidays.each do |holiday| %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="display: inline-block; width: 1.25rem; height: 1.25rem; border-radius: 4px; background-color: <%= holiday.color %>; border: 1px solid rgba(0,0,0,0.2);"></span>
                <strong><%= holiday.title %></strong>
              </div>
            </td>
            <td><%= holiday.start_date.strftime("%a, %-d %b %Y") %></td>
            <td><%= holiday.end_date.strftime("%a, %-d %b %Y") %></td>
            <td><%= (holiday.end_date - holiday.start_date).to_i + 1 %> days</td>
            <td><%= holiday.notes.presence || "-" %></td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 0.5rem;">
                <%= link_to "Edit", edit_school_holiday_path(holiday), role: "button", class: "secondary outline", style: "padding: 0.25rem 0.75rem; font-size: 0.875rem;" %>
                <%= button_to "Delete", school_holiday_path(holiday), method: :delete, data: { turbo_confirm: "Are you sure you want to remove #{holiday.title}?" }, class: "contrast outline", style: "padding: 0.25rem 0.75rem; font-size: 0.875rem;" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

