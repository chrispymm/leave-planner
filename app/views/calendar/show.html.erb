<turbo-frame id="calendar_frame">
  

  <div class="calendar-layout-container">
    <!-- Left Column: 12-Month Calendar Grid -->
    <div class="calendar-main-col">
      <!-- Calendar Controls & Navigation Bar -->
  <div class="calendar-controls">
    <div class="calendar-year-navigation">
      <%= link_to "‹", calendar_path(start_date: (@start_date - 1.year).to_s, reset_leave_year_details: 1, **@layout_params), class: "nav-btn secondary outline calendar-year-arrow", title: "Previous year", aria: { label: "Previous year" } %>
      <div class="calendar-year-title"><%= @start_date.year %></div>
      <%= link_to "›", calendar_path(start_date: (@start_date + 1.year).to_s, reset_leave_year_details: 1, **@layout_params), class: "nav-btn secondary outline calendar-year-arrow", title: "Next year", aria: { label: "Next year" } %>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <% if @people.any? %>
        <%= link_to "📅 Book Range", modal_leave_entries_path(date: @start_date.to_s, calendar_start_date: @start_date.to_s, **@layout_params), data: { turbo_frame: "modal_frame" }, role: "button", class: "nav-btn", style: "background-color: #0284c7; border-color: #0284c7; color: white;" %>
      <% end %>
      <%= link_to "⚙️", edit_account_path, data: { turbo_frame: "_top" }, role: "button", class: "nav-btn secondary outline", title: "Account settings", aria: { label: "Account settings" } %>
      <%= link_to "Sign out", session_path, data: { turbo_method: :delete, turbo_frame: "_top" }, role: "button", class: "nav-btn secondary outline" %>
    </div>
  </div>

      <% if @layout == "list" %>
        <div class="calendar-list-12">
          <% @months.each do |month_date| %>
            <%= render "calendar/month_list", month_date: month_date %>
          <% end %>
        </div>
      <% else %>
        <div class="calendar-grid-12">
          <% @months.each do |month_date| %>
            <%= render "calendar/month_grid", month_date: month_date %>
          <% end %>
        </div>
      <% end %>

      <!-- Legend Bar -->
      <div class="legend-bar">
        <strong>Legend:</strong>
        <div class="legend-item">
          <span class="legend-swatch" style="background-color: var(--bank-holiday-bg); border-color: var(--bank-holiday-border);"></span>
          <span>UK Bank Holiday</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch" style="background-color: #fff; box-shadow: inset 0 -4px 0 0 var(--school-holiday-border);"></span>
          <span>School Holiday</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch" style="background-color: var(--weekend-bg);"></span>
          <span>Weekend</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch" style="border: 2px solid var(--today-border); background-color: #fff;"></span>
          <span>Today</span>
        </div>
        <% @people.each do |person| %>
          <div class="legend-item">
            <span class="legend-swatch" style="background-color: <%= person.color %>;"></span>
            <span><%= person.name %> Leave</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Person Allowances Sidebar -->
    <div class="calendar-sidebar-col">
      <% @people.each do |person| %>
        <div class="person-card" style="border-top: 4px solid <%= person.color %>;">
          <div class="person-card-header">
            <span class="person-color-dot" style="background-color: <%= person.color %>;"></span>
            <%= link_to person_leave_ranges_path(person), data: { turbo_frame: "_top" }, style: "color: inherit; text-decoration: none;", title: "View #{person.name}'s leave list" do %>
              <strong style="font-size: 1.05rem;"><%= person.name %></strong>
            <% end %>
            <%= link_to edit_person_path(person), data: { turbo_frame: "_top" }, title: "Edit #{person.name}'s leave settings", style: "margin-left: auto; text-decoration: none; font-size: 1rem; line-height: 1; opacity: 0.75; transition: opacity 0.15s;" do %>
              ⚙️
            <% end %>
          </div>

          <% @allowance_ranges_by_person.fetch(person).each do |leave_year_range| %>
            <%
              starting_val = person.starting_allowance(leave_year_range)
              used = person.used_allowance(leave_year_range)
              remaining = person.remaining_allowance(leave_year_range)
              unit = person.allowance_unit
            %>
            <details
              class="leave-year-summary"
              data-leave-year="<%= leave_year_label(leave_year_range) %>"
              data-controller="persistent-details"
              data-persistent-details-storage-key-value="annual-leave-planner:leave-year:<%= person.id %>:<%= leave_year_range.begin.iso8601 %>"
              data-persistent-details-reset-value="<%= @reset_leave_year_details %>"
              data-action="toggle->persistent-details#save"
              <%= "open" if leave_year_range == person.leave_year_range(Date.current) %>
            >
              <summary class="leave-year-summary-title">
                Leave year <%= leave_year_label(leave_year_range) %>
                <small><%= leave_year_range.begin.strftime("%-d %b %Y") %> – <%= leave_year_range.end.strftime("%-d %b %Y") %></small>
              </summary>
              <div class="stats-row">
                <span>Used:</span>
                <span class="stats-value" style="color: <%= person.color %>;"><%= person.format_amount(used) %>/<%= person.format_amount(starting_val) %> <%= unit %></span>
              </div>
              <div class="stats-row">
                <span style="font-weight: 600;">Remaining:</span>
                <span class="stats-value" style="font-size: 1rem; color: <%= remaining >= 0 ? '#059669' : '#dc2626' %>;">
                  <%= person.format_amount(remaining) %> <%= unit %>
                </span>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>

      <% if @people.empty? %>
        <article style="text-align: center; padding: 1.5rem;">
          <p style="margin-bottom: 0.5rem; font-size: 0.85rem;">No people added yet.</p>
          <%= link_to "+ Add Person", new_person_path, data: { turbo_frame: "_top" }, role: "button", style: "font-size: 0.85rem;" %>
        </article>
      <% end %>

      <!-- Holiday Settings Quick Links -->
      <div style="margin-top: 1rem; padding: 0.75rem 1rem; background-color: var(--pico-card-background-color, #ffffff); border: 1px solid var(--border-color); border-radius: 8px; font-size: 0.875rem;">
        <div style="font-weight: 600; color: var(--pico-muted-color); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
          Holiday Calendars
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <%= link_to school_holidays_path, data: { turbo_frame: "_top" }, style: "display: flex; align-items: center; justify-content: space-between; text-decoration: none; color: var(--pico-color);" do %>
            <span>🎒 School Holidays</span>
            <span style="font-size: 0.8rem; color: var(--pico-muted-color);">Manage ›</span>
          <% end %>
          <%= link_to bank_holidays_path, data: { turbo_frame: "_top" }, style: "display: flex; align-items: center; justify-content: space-between; text-decoration: none; color: var(--pico-color); border-top: 1px solid var(--border-color); padding-top: 0.5rem;" do %>
            <span>🇬🇧 Bank Holidays</span>
            <span style="font-size: 0.8rem; color: var(--pico-muted-color);">View ›</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</turbo-frame>
