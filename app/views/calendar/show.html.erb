<turbo-frame id="calendar_frame">
  <!-- Calendar Controls & Navigation Bar -->
  <div class="calendar-controls">
    <div class="nav-btn-group">
      <%= link_to "« -1 Year", calendar_path(start_date: (@start_date - 1.year).to_s, person_id: @selected_person&.id), class: "nav-btn secondary outline", title: "Go back 1 year" %>
      <%= link_to "‹ -1 Month", calendar_path(start_date: (@start_date - 1.month).to_s, person_id: @selected_person&.id), class: "nav-btn secondary outline", title: "Go back 1 month" %>
      <%= link_to "Today", calendar_path(start_date: Date.current.beginning_of_month.to_s, person_id: @selected_person&.id), class: "nav-btn contrast", title: "Jump to current month" %>
      <%= link_to "+1 Month ›", calendar_path(start_date: (@start_date + 1.month).to_s, person_id: @selected_person&.id), class: "nav-btn secondary outline", title: "Go forward 1 month" %>
      <%= link_to "+1 Year »", calendar_path(start_date: (@start_date + 1.year).to_s, person_id: @selected_person&.id), class: "nav-btn secondary outline", title: "Go forward 1 year" %>
    </div>

    <div style="font-size: 1.15rem; font-weight: 700; color: var(--pico-color);">
      <%= @start_date.strftime("%B %Y") %> &ndash; <%= (@start_date + 11.months).strftime("%B %Y") %>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
      <% if @people.any? %>
        <span style="font-size: 0.875rem; color: var(--pico-muted-color);">Selected Person:</span>
        <% @people.each do |p| %>
          <%= link_to calendar_path(start_date: @start_date.to_s, person_id: p.id), class: "nav-btn #{p == @selected_person ? 'contrast' : 'secondary outline'}", style: (p == @selected_person ? "background-color: #{p.color}; border-color: #{p.color}; color: white;" : "border-color: #{p.color}; color: #{p.color};") do %>
            <%= p.name %>
          <% end %>
        <% end %>
        <%= link_to "📅 Book Range", modal_leave_entries_path(date: @start_date.to_s, calendar_start_date: @start_date.to_s, person_id: @selected_person&.id), data: { turbo_frame: "modal_frame" }, role: "button", class: "nav-btn", style: "background-color: #0284c7; border-color: #0284c7; color: white;" %>
      <% end %>
    </div>
  </div>

  <div class="calendar-layout-container">
    <!-- Left Column: 12-Month Calendar Grid -->
    <div class="calendar-main-col">
      <div class="calendar-grid-12">
        <% @months.each do |month_date| %>
          <div class="month-card">
            <div class="month-header">
              <%= month_date.strftime("%B %Y") %>
            </div>

            <div class="days-of-week">
              <% CalendarHelper::DAY_NAMES.each do |dn| %>
                <div><%= dn[0] %></div>
              <% end %>
            </div>

            <div class="month-days-grid">
              <% month_grid_cells(month_date).each do |date| %>
                <% if date.nil? %>
                  <div class="day-cell empty"></div>
                <% else %>
                  <%
                    is_weekend = date.saturday? || date.sunday?
                    is_today = (date == Date.current)
                    bank_holiday = @bank_holidays_map[date]
                    school_holidays = @school_holidays_map[date]
                    entries = @leave_entries_by_date[date] || []

                    classes = ["day-cell"]
                    classes << "weekend" if is_weekend
                    classes << "today" if is_today
                    classes << "bank-holiday" if bank_holiday
                    classes << "school-holiday" if school_holidays.present?
                  %>

                  <%= link_to modal_leave_entries_path(date: date.to_s, calendar_start_date: @start_date.to_s, person_id: @selected_person&.id), data: { turbo_frame: "modal_frame" }, class: classes.join(" "), title: [date.strftime("%a %-d %b"), bank_holiday&.title, school_holidays&.map(&:title)&.join(", ")].compact.join(" • ") do %>
                    <div class="day-number" style="<%= is_today ? 'color: var(--today-border);' : '' %>">
                      <%= date.day %>
                    </div>

                    <div class="day-badges">
                      <% if bank_holiday %>
                        <div class="bh-badge" title="<%= bank_holiday.title %>">
                          🏛️ <%= bank_holiday.title %>
                        </div>
                      <% end %>

                      <% entries.each do |entry| %>
                        <span class="leave-badge" style="background-color: <%= entry.person.color %>;" title="<%= entry.person.name %>: <%= entry.half_day? ? entry.half_day : 'Full day' %>">
                          <%= entry.person.name.first(1) %>
                          <% if entry.custom_hours.present? %>
                            (<%= entry.custom_hours %>h)
                          <% elsif entry.half_day? %>
                            (<%= entry.half_day == 'morning' ? 'AM' : 'PM' %>)
                          <% end %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Legend Bar -->
      <div class="legend-bar">
        <strong>Legend:</strong>
        <div class="legend-item">
          <span class="legend-swatch" style="background-color: var(--bank-holiday-bg); border-color: var(--bank-holiday-border);"></span>
          <span>UK Bank Holiday</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch" style="background-color: #fff; box-shadow: inset 0 -4px 0 0 var(--school-holiday-border);"></span>
          <span>School Holiday</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch" style="background-color: var(--weekend-bg);"></span>
          <span>Weekend</span>
        </div>
        <div class="legend-item">
          <span class="legend-swatch" style="border: 2px solid var(--today-border); background-color: #fff;"></span>
          <span>Today</span>
        </div>
        <% @people.each do |person| %>
          <div class="legend-item">
            <span class="legend-swatch" style="background-color: <%= person.color %>;"></span>
            <span><%= person.name %> Leave</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Person Allowances Sidebar -->
    <div class="calendar-sidebar-col">
      <div style="font-weight: 700; font-size: 1rem; color: var(--pico-color); margin-bottom: -0.25rem; display: flex; justify-content: space-between; align-items: center;">
        <span>Leave Allowances</span>
        <%= link_to "Manage", people_path, style: "font-size: 0.8rem; font-weight: normal; text-decoration: none;" %>
      </div>

      <% @people.each do |person| %>
        <%
          current_year_range = person.leave_year_range(@start_date)
          is_initial_active = person.initial_allowance_active_for?(current_year_range)
          starting_val = person.starting_allowance(current_year_range)
          used = person.used_allowance(current_year_range, bank_holidays_set: @bank_holidays_set)
          remaining = person.remaining_allowance(current_year_range, bank_holidays_set: @bank_holidays_set)
          unit = person.allowance_unit
        %>
        <div class="person-card" style="border-top: 4px solid <%= person.color %>;">
          <div class="person-card-header">
            <span class="person-color-dot" style="background-color: <%= person.color %>;"></span>
            <strong style="font-size: 1.05rem;"><%= person.name %></strong>
            <% if person.include_bank_holidays? %>
              <span style="font-size: 0.65rem; background-color: #fef3c7; color: #92400e; padding: 2px 5px; border-radius: 4px; margin-left: auto;">Incl. BH</span>
            <% else %>
              <span style="font-size: 0.65rem; background-color: #d1fae5; color: #065f46; padding: 2px 5px; border-radius: 4px; margin-left: auto;">Excl. BH</span>
            <% end %>
          </div>

          <div class="stats-row">
            <span><%= is_initial_active ? "Starting Balance:" : "Entitlement:" %></span>
            <span class="stats-value">
              <%= person.format_amount(starting_val) %> <%= unit %>
              <% if is_initial_active %>
                <small style="display: block; font-weight: normal; font-size: 0.7rem; color: #0284c7;">(as of <%= person.initial_allowance_date.strftime("%-d %b") %>)</small>
              <% end %>
            </span>
          </div>
          <div class="stats-row">
            <span><%= is_initial_active ? "Booked Since:" : "Booked in Year:" %></span>
            <span class="stats-value" style="color: <%= person.color %>;"><%= person.format_amount(used) %> <%= unit %></span>
          </div>
          <div class="stats-row" style="margin-top: 0.4rem; padding-top: 0.35rem; border-top: 1px dashed var(--border-color);">
            <span style="font-weight: 600;">Remaining:</span>
            <span class="stats-value" style="font-size: 1rem; color: <%= remaining >= 0 ? '#059669' : '#dc2626' %>;">
              <%= person.format_amount(remaining) %> <%= unit %>
            </span>
          </div>
          <div style="font-size: 0.72rem; color: var(--pico-muted-color); margin-top: 0.4rem; text-align: right;">
            Year resets: <%= person.leave_year_start_day_formatted %>
          </div>
        </div>
      <% end %>

      <% if @people.empty? %>
        <article style="text-align: center; padding: 1.5rem;">
          <p style="margin-bottom: 0.5rem; font-size: 0.85rem;">No people added yet.</p>
          <%= link_to "+ Add Person", new_person_path, role: "button", style: "font-size: 0.85rem;" %>
        </article>
      <% end %>
    </div>
  </div>
</turbo-frame>

